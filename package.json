{
	"name": "lot",
	"version": "0.19",
	"private": true,
	"description": "Arcade'owy lot nad prawdziwą mapą Polski – WebGPU (Three.js)",
	"author": "Marcin Murawski",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"start": "node server.js",
		"test": "node --test \"tests/*.test.js\"",
		"vendor": "node tools/vendor.js",
		"bake": "node tools/bake-region.js",
		"bake:osm": "node tools/bake-osm.js",
		"bake:gen": "node tools/bake-gen.js",
		"bake:labels": "node tools/bake-labels.js",
		"icon": "node tools/make-icon.js",
		"web": "node tools/web.js",
		"app": "electron .",
		"app:check": "node tools/app-check.js",
		"dist": "node tools/dist.js",
		"dist:dir": "node tools/dist.js --dir"
	},
	"devDependencies": {
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"three": "0.186.1"
	},
	"build": {
		"appId": "pl.lot.nadpolska",
		"productName": "Lot nad Polską",
		"copyright": "© 2026 Marcin Murawski",
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"electronDist": "node_modules/electron/dist",
		"files": [
			"index.html",
			"style.css",
			"favicon.ico",
			"icons/**",
			"src/**",
			"vendor/three/**",
			"data/regions/**",
			"!data/regions/*/preview.png",
			"electron/**",
			"package.json"
		],
		"asar": true,
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.png"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Lot nad Polską",
			"artifactName": "Lot-nad-Polska-${version}-instalator.${ext}"
		},
		"portable": {
			"artifactName": "Lot-nad-Polska-${version}-przenosna.${ext}"
		}
	}
}
